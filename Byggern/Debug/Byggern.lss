000006b6 <display_cmd>:
void draw_filled_circle(uint8_t cx, uint8_t cy, uint8_t r){
	for(int y = -r; y <= r; y++){
		int dx = (int)(sqrt((double)(r*r-y*y)) + 0.5);
		for(int x = -dx; x <= dx; x++) display_pixel_on(cx+x,cy+y);
	}
}
